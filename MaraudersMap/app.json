{
  "pages": [
    "pages/cover/cover",
    "pages/map/map",
    "pages/geo1f/geo1f"
  ],
  "subPackages": [
    {
      "root": "packageMemo",
      "name": "memo",
      "pages": [
        "pages/memo/memo"
      ]
    }
  ],
  "preloadRule": {
    "pages/cover/cover": {
      "network": "all",
      "packages": ["memo"]
    },
    "pages/map/map": {
      "network": "all",
      "packages": ["memo"]
    }
  },
  "window": {
    "backgroundColor": "#0E1220",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#0E1220",
    "navigationBarTitleText": "时刻准备着",
    "navigationBarTextStyle": "white",
    "navigationStyle": "custom"
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "用于在地图上展示并回到你的当前位置"
    }
  },
  "requiredPrivateInfos": [
    "getLocation"
  ]
}
