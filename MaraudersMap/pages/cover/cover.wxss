/* ====================================================================
   地图视图：上滑后在【同一页面内】呈现，不跳转页面
   可调参数（只改这一段，与封面页的图层参数互不干扰）：

   1) 地图区域 --map-left/right/top/bottom：四边内缩量
   2) 图标 --*-idle-x/y = 贴图中心点位置（左下角，距左 / 距下边缘）—— 固定不动；
      --sway-x/y = 原地漂浮幅度（都设 0 即静止）；--hover-duration = 漂浮一轮的用时
      —— 只有原地漂浮，不再有随机漂移，也不再有范围 / 防重叠判定
   3) 淡入 900ms / 淡出 600ms 写在下面 .map-view 的 transition 里
      （与 cover.js 的 MAP_FADE_IN_MS / MAP_FADE_OUT_MS 一致）
      —— 想要「瞬间出现」：把这两处的时长都改成 0s 即可
   ==================================================================== */
.map-view {
  /* 地图区域：落在漂浮环以内的矩形（上边留给退出按钮，下边留给漂浮环） */
  --map-left: 10%;
  --map-right: 10%;
  --map-top: 13%;
  --map-bottom: 11%;

  /* 图标初始位置（左下角，距左边缘 / 距下边缘） */
  --inkbox-idle-x: 89rpx;
  --inkbox-idle-y: 160rpx;
  --quill-idle-x: 260rpx;
  --quill-idle-y: 90rpx;

  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 6; /* 盖住右下角装饰；同时自成层级，内部元素按下面的 z-index 排列 */
}

/* 地图区域：划定在 parchment 之上，四边内缩，屏幕外围一圈留给图标漂浮，两者不重合 */
.map-stage {
  position: absolute;
  left: var(--map-left, 10%);
  right: var(--map-right, 10%);
  top: var(--map-top, 10%);
  bottom: var(--map-bottom, 10%);
  z-index: 4;
}

/* 图窗：位置由 cover.js 按 MAP_WINDOW.left / .bottom（距屏幕左边、下边）下发，
   尺寸按 MAP_WINDOW.scale 等比缩放后贴合手绘图，四周零留白；
   尺寸不可拖拽改变：不与 map 的缩放联动，min-scale 也锁在入场级别（禁止缩小）
   圆角 + overflow 负责裁掉地图原生直角；圆角描边 .map-frame 与它同尺寸，天然对齐 */
.map-window {
  position: absolute;
  border-radius: 24rpx;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* 圆角描边：明确框出地图区域，同时遮住原生 map 的直角 */
.map-frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  pointer-events: none;
}

/* ---------------- 「我的位置」脚印 + 行走尾迹 ----------------
   已改为原生 marker 渲染（不再有 DOM 覆盖层，也就没有对应的样式）：
   marker 直接绑经纬度，缩放 / 拖动 / 旋转全程与地图严格同步，脚印不会偏移或突变。
   ★ 脚印 / 尾迹的所有可调参数（间距、步幅、闪烁与落步周期、角度偏差、尾迹步幅与寿命、
     暗淡程度）都集中在 pages/cover/cover.js 顶部的「可调参数」注释块里；
   脚印贴图由 _tools/make-footprint.js 按 app.wxss 的 .footprint__sole / .footprint__heel 数值生成。 */

/* ---------------- 左下角图标 ---------------- */
/* 位置不再由 JS 改写：left / top 就是固定摆位（idy-x / idle-y，见参数区），
   动效只有 orbit-sway —— 在原地小幅上浮 + 轻轻摇摆，中心点任何时刻都不离开原位，
   所以既不会跑到屏幕别处，也不会把两个贴图挤到一起 */
.orbit {
  position: absolute;
  left: var(--idle-x, 90rpx);
  top: calc(100% - var(--idle-y, 160rpx));
  width: var(--orbit-w, 200rpx);
  height: var(--orbit-h, 142rpx);
  pointer-events: none;
  z-index: 6;
  transform: translate(-50%, -50%);
  animation: orbit-sway var(--hover-duration, 5s) ease-in-out infinite;
  /* 上浮 / 复位走过渡，与模式启停同步（orbit-sway 只动 transform，不干扰 top） */
  transition: top var(--tool-lift-duration, 240ms) ease;
}

/* 图片本身只负责旋转与缩放，避免与外层的漂浮/绕行动画互相覆盖 */
.orbit__img {
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: center center;
  transform: rotate(var(--img-rotate, 0deg)) scale(var(--img-scale, 1));
}

.orbit--inkbox {
  --idle-x: var(--inkbox-idle-x, 90rpx);
  --idle-y: var(--inkbox-idle-y, 160rpx);
  --sway-x: var(--inkbox-sway-x, 6rpx);
  --sway-y: var(--inkbox-sway-y, 10rpx);
  --orbit-w: 200rpx;
  --orbit-h: 142rpx;
  --orbit-opacity: 1;
  --hover-duration: 5s;
  --img-rotate: -30deg;
  --img-scale: 1;
}

.orbit--quill {
  --idle-x: var(--quill-idle-x, 260rpx);
  --idle-y: var(--quill-idle-y, 90rpx);
  --sway-x: var(--quill-sway-x, 7rpx);
  --sway-y: var(--quill-sway-y, 12rpx);
  --orbit-w: 180rpx;
  --orbit-h: 127rpx;
  --orbit-opacity: 1;
  /* 周期 6.4s，与 inkbox 的 5s 不同步，看起来像各自在漂 */
  --hover-duration: 6.4s;
  --img-rotate: 0deg;
  --img-scale: 1;
}

/* ---------------- 绘制工具：墨水瓶 / 羽毛笔 ---------------- */
/* 作为工具按钮：必须能点（.orbit 默认放行手势，这里单独打开） */
.orbit--inkbox,
.orbit--quill {
  pointer-events: auto;
}

/* 绘制模式启用中：当前工具上浮 --tool-lift（默认 20rpx）并轻微放大，
   退出模式后类被移除 → 自动回落原位（top 有过渡） */
.orbit.is-active {
  top: calc(100% - var(--idle-y, 160rpx) - var(--tool-lift, 20rpx));
}

.orbit.is-active .orbit__img {
  transform: rotate(var(--img-rotate, 0deg)) scale(calc(var(--img-scale, 1) * 1.08));
}

/* 顶部状态提示条：node / path 模式各自显示当前可做的操作 */
.mode-tip {
  position: absolute;
  left: 50%;
  top: 12%;
  transform: translateX(-50%);
  z-index: 7;
  max-width: 72%;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(124, 45, 18, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.mode-tip__text {
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
  color: #fff7ed;
}

/* 按下反馈：比 .map-view.is-entered .orbit 多一层类，优先级足够 */
.map-view.is-entered .orbit.orbit--hover {
  opacity: 0.82;
}

/* ---------------- 地图视图的淡入 / 淡出 ----------------
   基础态 = 正在退场（600ms 淡出）；.is-entered = 正在 / 已完成入场（900ms 淡入）
   原生 <map> 元素自身也吃 opacity，所以地图本体与容器一起淡入 */
.map-view .map,
.map-view .map-frame,
.map-view .orbit,
.map-view .exit-wrap {
  opacity: 0;
  transition: opacity 600ms ease;
}

.map-view.is-entered .map,
.map-view.is-entered .map-frame,
.map-view.is-entered .exit-wrap {
  opacity: 1;
  transition: opacity 900ms ease;
}

.map-view.is-entered .orbit {
  opacity: var(--orbit-opacity, 1);
  transition: opacity 900ms ease;
}

/* ---------------- 退出按钮（精简后唯一保留的控件） ---------------- */
.exit-wrap {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 5;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.exit {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  border: 2rpx solid rgba(203, 213, 225, 0.35);
  background: rgba(14, 18, 32, 0.5);
}

.exit--hover {
  background: rgba(14, 18, 32, 0.8);
}

.exit__icon {
  font-size: 38rpx;
  line-height: 40rpx;
  color: #cbd5e1;
  margin-right: 6rpx;
}

.exit__label {
  font-size: 26rpx;
  color: #cbd5e1;
}

/* 原地轻浮：只做很小的位移（不做旋转），中心点始终落在 left / top 上；
   幅度由 --sway-x / --sway-y 控制，设 0 即静止 */
@keyframes orbit-sway {
  0% {
    transform: translate(-50%, -50%) translate(0, 0);
  }
  25% {
    transform: translate(-50%, -50%) translate(var(--sway-x, 6rpx), calc(var(--sway-y, 12rpx) * -0.6));
  }
  50% {
    transform: translate(-50%, -50%) translate(0, calc(var(--sway-y, 12rpx) * -1));
  }
  75% {
    transform: translate(-50%, -50%)
      translate(calc(var(--sway-x, 6rpx) * -1), calc(var(--sway-y, 12rpx) * -0.6));
  }
  100% {
    transform: translate(-50%, -50%) translate(0, 0);
  }
}
