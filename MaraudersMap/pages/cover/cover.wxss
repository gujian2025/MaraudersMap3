/* pages/cover/cover.wxss */
/* 内嵌 base64 的自定义字体声明（自动生成），必须放在最前面 */
@import "cover-font.wxss";

/* ===================== 图层可调参数（只改这一段） =====================
   两个图层用不同的布局方式（都可直接改数字，无需动其它代码）：

   【table】中心点 + 尺寸
     x / y = 图片中心点坐标（% 或 rpx，可写 -20% / 130% 伸出视口）
     w / h = 盒子尺寸；scale = 整体缩放倍率（以图片中心为基点）
     mode = aspectFit：等比缩放装进 w×h，实际倍率 = min(w/471, h/139)。
       横图受【宽度】限制，只改 h 可能看不出变化，放大请同时加大 w 和 h。

   【parchment】宽度 + 宽度上限（等比，永不溢出屏幕）
     w = 占屏幕宽度的比例（% 相对屏幕宽）：90% → 左右各留 5%
     max-w = 宽度上限，用 vh 兜住矮屏：原图 887×1774（约 1:2），
       纸高 = 2 × 纸宽，所以 44vh → 纸高 ≤ 88vh，小屏 / 平板都不会超出可视区
     y = 纸面中心点在屏幕高度上的位置（50% = 垂直居中）
     scale = 整体缩放倍率（以图片中心为基点），>1 放大、<1 缩小
     mode = widthFix：只给宽度，高度按原图比例自动算出，绝不会被拉伸变形
     rim-opacity = 环绕纹理的浓淡（纹理按 6966×3921 原比例呈现、垂直居中，
      0 = 不显示，1 = 完全显示）

   【inkbox / quill】右下角装饰：距右边 + 距下边 + 尺寸
     right / bottom = 图片到屏幕右边缘 / 下边缘的距离（rpx 或 %，可写负值）
     w / h = 尺寸。用 right/bottom 贴住右下角，所以放大时角落不动、向左上生长
     scale = 整体缩放倍率（以图片中心为基点）
     mode = scaleToFill：铺满 w×h；想不变形则令 h = w × 0.708（原图 900×637）
     float-x / float-y / float-rotate / float-duration = 浮动摇晃的水平幅度、
       垂直幅度、摇摆角度、一轮用时（前三个都设 0 即静止）

   opacity = 透明度 0~1；rotate = 旋转角度
   ==================================================================== */
.cover {
  /* 图层① table：中心点 + 尺寸 */
  --table-x: 50%;
  --table-y: 98%;
  --table-h: 280rpx;
  --table-scale: 1;
  --table-opacity: 1;
  --table-rotate: 0deg;

  /* 图层② parchment：宽度 + 宽度上限 + 缩放 */
  --parchment-w: 90%;
  --parchment-max-w: 44vh;
  --parchment-y: 50%;
  --parchment-scale: 1.1;
  --parchment-opacity: 1;
  --parchment-rotate: 0deg;
  /* 环绕纹理浓淡：0 = 不显示纹理，1 = 完全显示 */
  --parchment-rim-opacity: 0.7;

  /* 图层③ inkbox：右下角装饰（距右 / 距下边定位） */
  --inkbox-right: 450rpx;
  --inkbox-bottom: 40rpx;
  --inkbox-w: 320rpx;
  --inkbox-h: 226rpx;
  --inkbox-scale: 0.7;
  --inkbox-opacity: 1;
  --inkbox-rotate: -30deg;
  /* 浮动摇晃：x / y = 位移幅度，rotate = 摇摆角度，duration = 一轮用时
     （三个幅度都设为 0 即静止） */
  --inkbox-float-x: 8rpx;
  --inkbox-float-y: 12rpx;
  --inkbox-float-rotate: 2deg;
  --inkbox-float-duration: 5s;

  /* 图层④ quill：右下角装饰，叠在 inkbox 之上 */
  --quill-right: 300rpx;
  --quill-bottom: 30rpx;
  --quill-w: 300rpx;
  --quill-h: 212rpx;
  --quill-scale: 0.7;
  --quill-opacity: 1;
  --quill-rotate: 0deg;
  /* 周期取 6.4s，与 inkbox 的 5s 不同步，看起来像各自漂着 */
  --quill-float-x: 10rpx;
  --quill-float-y: 14rpx;
  --quill-float-rotate: 2.5deg;
  --quill-float-duration: 6.4s;

  /* 地图视图里左下角的两个贴图（.orbit）：位置固定不动，只做原地小幅漂浮
       idle-x = 中心点距屏幕左边的距离；idle-y = 中心点距屏幕下边的距离
       sway-x / sway-y = 原地漂浮的幅度，都设 0 即完全静止
       hover-duration = 一轮漂浮用时（两个取值不同，节奏不同步） */
  --inkbox-idle-x: 90rpx;
  --inkbox-idle-y: 160rpx;
  --inkbox-sway-x: 6rpx;
  --inkbox-sway-y: 10rpx;
  --quill-idle-x: 260rpx;
  --quill-idle-y: 90rpx;
  --quill-sway-x: 6rpx;
  --quill-sway-y: 15rpx;
  /* 绘制模式下当前工具上浮的距离 / 上浮回落的过渡时长 */
  --tool-lift: 20rpx;
  --tool-lift-duration: 240ms;

  /* 【星星】装饰层：夹在背景（0/1）与 parchment（3）之间，层级 2
     排列方式与参考图 bg-page-star.jpg（540×1080）一致：
       star-1 满幅金线层 / star-3 右上 / star-2 右中 / star-5 左中 / star-4 左下（月）
     只做很轻的漂浮，不遮挡 parchment 内容
       x / y = 中心点坐标（% 相对屏幕宽 / 高，也可写 rpx；负值 = 伸出视口）
       w    = 宽度；高度由原图比例自动算出（mode=widthFix），绝不会被拉变形
              原图比例 star-1 1:2.000 / star-2 1:1.156 / star-3 1:1.702
                      star-4 1:1.396 / star-5 1:1.095
       opacity = 透明度（0~1）
       float-x / float-y = 浮动幅度（水平 / 垂直），都设 0 即静止
       float-rotate = 摇摆角度
       float-duration = 一轮用时；float-delay = 起始相位
         —— 五颗星的 duration 互不相同、delay 取负值，一开始就在各自的中途，
            节奏互相错开，不会整齐地一起动 */
  /* 参数按参考图（bg-page-star.jpg，540×1080）等比换算：
     左/上/宽 的百分比 ÷ 540 得到图中比例，宽再 ×750 得到 rpx；
     x / y 为图片中心点 = 左边 + 宽/2、上边 + 高/2 */
  /* 图中 537×1075 @ (2,3)：整幅铺满的金色线条层 */
  --star1-x: 50%;
  --star1-y: 50%;
  --star1-w: 746rpx;
  --star1-opacity: 0.9;
  /* 满幅图，漂浮幅度刻意比其它几颗更小，避免边缘明显位移 */
  --star1-float-x: 3rpx;
  --star1-float-y: 6rpx;
  --star1-float-rotate: 1deg;
  --star1-float-duration: 7s;
  --star1-float-delay: -0.4s;

  /* 图中 361×417 @ (175,305)：右侧中部 */
  --star2-x: 65.8%;
  --star2-y: 47.5%;
  --star2-w: 501rpx;
  --star2-opacity: 0.85;
  --star2-float-x: 7rpx;
  --star2-float-y: 12rpx;
  --star2-float-rotate: 2deg;
  --star2-float-duration: 8.4s;
  --star2-float-delay: -2.1s;

  /* 图中 209×356 @ (281,229)：右上 */
  --star3-x: 20%;
  --star3-y: 17.7%;
  --star3-w: 290rpx;
  --star3-opacity: 0.75;
  --star3-float-x: 6rpx;
  --star3-float-y: 9rpx;
  --star3-float-rotate: 1.5deg;
  --star3-float-duration: 9.6s;
  --star3-float-delay: -3.6s;

  /* 图中 234×327 @ (88,612)：左下（月亮） */
  --star4-x: 38%;
  --star4-y: 71.8%;
  --star4-w: 325rpx;
  --star4-opacity: 0.8;
  --star4-float-x: 8rpx;
  --star4-float-y: 14rpx;
  --star4-float-rotate: 3deg;
  --star4-float-duration: 6.8s;
  --star4-float-delay: -1.2s;

  /* 图中 243×266 @ (14,438)：左侧中部 */
  --star5-x: 75.1%;
  --star5-y: 85.9%;
  --star5-w: 338rpx;
  --star5-opacity: 0.7;
  --star5-float-x: 6rpx;
  --star5-float-y: 11rpx;
  --star5-float-rotate: 2deg;
  --star5-float-duration: 10.4s;
  --star5-float-delay: -5.2s;

  /* ---- 以下为页面骨架，勿动 ---- */
  position: relative;
  width: 100%;
  height: 100vh;
  /* 不再裁剪子元素：图层①/② 可以任意放大、坐标可超出 0~100%，自由溢出视口。
     文字的裁剪与内边距交给下面的 .cover__safe 负责 */
  overflow: visible;
  /* background: linear-gradient(160deg, #0e1220 0%, #16243f 48%, #1e3a6b 100%); */
}

/* 文字安全区：与 parchment 用同一组宽度参数（w / max-w / y）+ 同一宽高比，
   于是它就是一个「和纸面完全重合」的框 —— 文字在任何屏幕上都只落在纸内；
   overflow: hidden 只对文字做裁剪，不影响纸面的布局。
   aspect-ratio 不生效的老版本会退化成「按内容高度居中」，仍不会溢出屏幕 */
.cover__safe {
  position: absolute;
  left: 50%;
  top: var(--parchment-y, 50%);
  width: var(--parchment-w, 90%);
  max-width: var(--parchment-max-w, 44vh);
  aspect-ratio: 887 / 1774;
  z-index: 7;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  /* 内边距 = 纸面内侧留白：顶部留出环绕纹理的位置，左右避开纸缘的缠枝纹 */
  padding: 150rpx 60rpx 80rpx;
  transform: translate(-50%, -50%);
  /* 上滑完成后文字缓慢淡出并微微上移，时长与 cover.js 的 FADE_OUT_MS 一致 */
  transition: opacity 700ms ease, transform 700ms ease;
}

/* 上滑达标：整块文字淡出 + 轻微上移，淡完就在同一页面内切出地图视图。
   只淡出文字/装饰/脚印，背景与 parchment 保持原样（不做页面跳转，没有切换痕迹）
   pointer-events: none —— 淡出后仍在最上层，必须放行点击，否则会挡住地图与退出按钮 */
.cover__safe.is-leaving {
  opacity: 0;
  transform: translate(-50%, -50%) translateY(-24rpx);
  pointer-events: none;
}

.cover__glow {
  position: absolute;
  border-radius: 50%;
  opacity: 0.35;
}

.cover__glow--a {
  width: 520rpx;
  height: 520rpx;
  top: -140rpx;
  right: -160rpx;
  background: radial-gradient(circle, #2f6bff 0%, rgba(47, 107, 255, 0) 70%);
}

.cover__glow--b {
  width: 680rpx;
  height: 680rpx;
  bottom: -240rpx;
  left: -220rpx;
  background: radial-gradient(circle, #12b76a 0%, rgba(18, 183, 106, 0) 70%);
  opacity: 0.22;
}

/* 背景图铺满全屏：aspectFill 等比缩放后裁掉溢出部分，不会拉伸变形 */
/* 图层顺序（数字越大越靠上）：
   0 背景图 bg-background-sky.jpg → 1 遮罩 → 2 星星装饰 → 3 parchment
   → 4 inkbox → 5 quill → 6 脚印 / 地图视图 → 7 文字安全区 */
.cover__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.cover__scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(14, 18, 32, 0.3) 0%,
    rgba(14, 18, 32, 0.45) 45%,
    rgba(14, 18, 32, 0.72) 100%
  );
}

/* ---------------- 星星装饰层（背景之上、parchment 之下） ----------------
   绝对定位 → 不参与布局流，不产生任何布局偏移；
   pointer-events: none → 不拦截封面的上滑 / 点击手势；
   z-index: 2 → 在背景(0) 与遮罩(1) 之上、parchment(3) 之下，不会遮挡 parchment 内容
   每个 var() 都带字面量兜底值，参数没定义时也能正常显示 */
.star {
  position: absolute;
  left: var(--star-x, 50%);
  top: var(--star-y, 50%);
  width: var(--star-w, 120rpx);
  opacity: var(--star-opacity, 1);
  /* 以自身中心点定位：x / y 就是星星中心的位置 */
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 2;
  /* 外层只做位移漂浮（幅度很小） */
  animation: star-float var(--star-float-duration, 7s) ease-in-out var(--star-float-delay, 0s) infinite;
}

/* 高度交给 widthFix 按原图比例自动算出 → 始终保持原始宽高比，不会被压扁或拉长
   内层只做极轻微的摇摆，与外层同周期同相位 */
.star__img {
  display: block;
  width: 100%;
  height: auto;
  animation: star-turn var(--star-float-duration, 7s) ease-in-out var(--star-float-delay, 0s) infinite;
}

/* 五颗星各自读取顶部参数区里的一组变量（位置 / 大小 / 透明度 / 浮动节奏） */
.star--1 {
  --star-x: var(--star1-x, 50%);
  --star-y: var(--star1-y, 50%);
  --star-w: var(--star1-w, 746rpx);
  --star-opacity: var(--star1-opacity, 0.9);
  --star-float-x: var(--star1-float-x, 3rpx);
  --star-float-y: var(--star1-float-y, 6rpx);
  --star-float-rotate: var(--star1-float-rotate, 1deg);
  --star-float-duration: var(--star1-float-duration, 7s);
  --star-float-delay: var(--star1-float-delay, -0.4s);
}

.star--2 {
  --star-x: var(--star2-x, 65.8%);
  --star-y: var(--star2-y, 47.5%);
  --star-w: var(--star2-w, 501rpx);
  --star-opacity: var(--star2-opacity, 0.85);
  --star-float-x: var(--star2-float-x, 7rpx);
  --star-float-y: var(--star2-float-y, 12rpx);
  --star-float-rotate: var(--star2-float-rotate, 2deg);
  --star-float-duration: var(--star2-float-duration, 8.4s);
  --star-float-delay: var(--star2-float-delay, -2.1s);
}

.star--3 {
  --star-x: var(--star3-x, 71.4%);
  --star-y: var(--star3-y, 37.7%);
  --star-w: var(--star3-w, 290rpx);
  --star-opacity: var(--star3-opacity, 0.75);
  --star-float-x: var(--star3-float-x, 6rpx);
  --star-float-y: var(--star3-float-y, 9rpx);
  --star-float-rotate: var(--star3-float-rotate, 1.5deg);
  --star-float-duration: var(--star3-float-duration, 9.6s);
  --star-float-delay: var(--star3-float-delay, -3.6s);
}

.star--4 {
  --star-x: var(--star4-x, 38%);
  --star-y: var(--star4-y, 71.8%);
  --star-w: var(--star4-w, 325rpx);
  --star-opacity: var(--star4-opacity, 0.8);
  --star-float-x: var(--star4-float-x, 8rpx);
  --star-float-y: var(--star4-float-y, 14rpx);
  --star-float-rotate: var(--star4-float-rotate, 3deg);
  --star-float-duration: var(--star4-float-duration, 6.8s);
  --star-float-delay: var(--star4-float-delay, -1.2s);
}

.star--5 {
  --star-x: var(--star5-x, 25.1%);
  --star-y: var(--star5-y, 52.9%);
  --star-w: var(--star5-w, 338rpx);
  --star-opacity: var(--star5-opacity, 0.7);
  --star-float-x: var(--star5-float-x, 6rpx);
  --star-float-y: var(--star5-float-y, 11rpx);
  --star-float-rotate: var(--star5-float-rotate, 2deg);
  --star-float-duration: var(--star5-float-duration, 10.4s);
  --star-float-delay: var(--star5-float-delay, -5.2s);
}

/* 轻微、连续的漂浮：只有很小的位移，靠 ease-in-out 走成缓慢来回 */
@keyframes star-float {
  0% {
    transform: translate(-50%, -50%) translate(0, 0);
  }
  25% {
    transform: translate(-50%, -50%)
      translate(var(--star-float-x, 6rpx), calc(var(--star-float-y, 10rpx) * -0.6));
  }
  50% {
    transform: translate(-50%, -50%) translate(0, calc(var(--star-float-y, 10rpx) * -1));
  }
  75% {
    transform: translate(-50%, -50%)
      translate(calc(var(--star-float-x, 6rpx) * -1), calc(var(--star-float-y, 10rpx) * -0.6));
  }
  100% {
    transform: translate(-50%, -50%) translate(0, 0);
  }
}

/* 极轻微的摇摆，与位移同步；即使不生效也不影响漂浮本身 */
@keyframes star-turn {
  0% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(var(--star-float-rotate, 2deg));
  }
  50% {
    transform: rotate(0deg);
  }
  75% {
    transform: rotate(calc(var(--star-float-rotate, 2deg) * -1));
  }
  100% {
    transform: rotate(0deg);
  }
}

/* 新增图片图层：绝对定位 → 脱离 flex 流，不占用也不改变原有文字布局；
   pointer-events: none → 不拦截封面的上滑/点击手势
   每个 var() 都带字面量兜底值：万一变量名写错/未定义，图层仍按默认值显示，
   不会出现尺寸为 0 的“空白图层” */
.cover__layer {
  position: absolute;
  pointer-events: none;
}



/* parchment：宽度决定整体尺寸（left:50% + translateX(-50%) 保持水平居中），
   高度由内层 image（mode=widthFix）按原图 887×1774 自动算出；
   max-width 用 vh 兜底 —— 矮屏上自动缩窄，纸面永远不会超出可视区 */
.cover__layer--parchment {
  left: 50%;
  top: var(--parchment-y, 50%);
  width: var(--parchment-w, 90%);
  max-width: var(--parchment-max-w, 44vh);
  opacity: var(--parchment-opacity, 1);
  transform-origin: center center;
  transform: translate(-50%, -50%) rotate(var(--parchment-rotate, 0deg))
    scale(var(--parchment-scale, 1));
  z-index: 3;
}

/* 纸面「展开 / 收回」时的过渡：与文字淡出同步（700ms = cover.js 的 FADE_OUT_MS）。
   两个状态都要有，退回到封面时才会同速收回 */
.cover__layer--parchment {
  transition: transform 700ms ease;
}

/* 上滑达标：纸面等比放大到铺满整屏。
   放大用的 transform 由 cover.js 内联下发（见 parchmentFillStyle）——
   CSS 的 calc() 不允许「长度 ÷ 长度」，倍率算不出来；内联 CSS 变量在部分基础库又会被丢掉，
   所以整条 transform 一起下发。这里只保留过渡，基础态的 transform 一字未改 */

.cover__paper {
  display: block;
  width: 100%;
  height: auto;
}

/* 环绕纹理：保持 pattern.png（6966×3921）的原有宽高比 —— mode=widthFix，
   只给宽度、高度自动算出，绝不压缩 / 拉伸；宽度与纸面同宽、垂直居中叠在纸面上。
   贴图主体集中在左右两侧与底边、中心近乎空白，再叠一层椭圆遮罩压掉中心 */
.cover__rim {
  position: absolute;
  left: 40rpx;
  top: 50%;
  width: 88%;
  height: auto;
  transform: translateY(-50%);
  opacity: var(--parchment-rim-opacity, 0.45);
  /* 上滑被捕捉到时与文字同步淡出（700ms，与 cover.js 的 FADE_OUT_MS 一致）；
     退出地图回到封面时按同一时长淡回来 */
  transition: opacity 700ms ease;
  -webkit-mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0) 55%, #000 92%);
  mask-image: radial-gradient(closest-side, rgba(0, 0, 0, 0) 55%, #000 92%);
}

/* 上滑达标：只收掉环绕纹理，羊皮纸本体保持原样（见 .cover__layer--parchment 的 opacity） */
.cover__layer--parchment.is-leaving .cover__rim {
  opacity: 0;
}

/* inkbox / quill：用 right / bottom 贴住右下角，改 w / h 时右下角位置不变。
   外层 view 只做「浮动摇晃」动画，内层 image 只负责 rotate / scale —— 分开写，
   动画的 transform 才不会覆盖你设置的旋转与缩放 */
.cover__layer-img {
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: center center;
}

.cover__layer--inkbox {
  right: var(--inkbox-right, 120rpx);
  bottom: var(--inkbox-bottom, 110rpx);
  width: var(--inkbox-w, 320rpx);
  height: var(--inkbox-h, 226rpx);
  opacity: var(--inkbox-opacity, 1);
  --float-x: var(--inkbox-float-x, 8rpx);
  --float-y: var(--inkbox-float-y, 12rpx);
  --float-rotate: var(--inkbox-float-rotate, 2deg);
  animation: float-sway var(--inkbox-float-duration, 5s) ease-in-out infinite;
  z-index: 4;
}

.cover__layer--quill {
  right: var(--quill-right, 20rpx);
  bottom: var(--quill-bottom, 30rpx);
  width: var(--quill-w, 300rpx);
  height: var(--quill-h, 212rpx);
  opacity: var(--quill-opacity, 1);
  --float-x: var(--quill-float-x, 10rpx);
  --float-y: var(--quill-float-y, 14rpx);
  --float-rotate: var(--quill-float-rotate, 2.5deg);
  animation: float-sway var(--quill-float-duration, 6.4s) ease-in-out infinite;
  z-index: 5;
}

.cover__layer--inkbox .cover__layer-img {
  transform: rotate(var(--inkbox-rotate, 0deg)) scale(var(--inkbox-scale, 1));
}

.cover__layer--quill .cover__layer-img {
  transform: rotate(var(--quill-rotate, 0deg)) scale(var(--quill-scale, 1));
}

/* 上滑后：右下角装饰与文字一起缓慢淡出（700ms，与 cover.js 的 FADE_OUT_MS 一致）；
   进入地图视图期间保持隐藏，退出回到封面时再淡回来。
   脚印层另用 .is-hidden 控制（它在地图视图里要再隐藏 3 秒才出现） */
.cover__layer--inkbox,
.cover__layer--quill,
.walk {
  transition: opacity 700ms ease;
}

.cover__layer--inkbox.is-leaving,
.cover__layer--quill.is-leaving,
.walk.is-hidden {
  opacity: 0;
}

/* 小幅上浮 + 轻轻摇摆：幅度由 --float-x / --float-y / --float-rotate 控制 */
@keyframes float-sway {
  0% {
    transform: translate(0, 0) rotate(0deg);
  }
  25% {
    transform: translate(var(--float-x, 8rpx), calc(var(--float-y, 12rpx) * -0.6)) rotate(var(--float-rotate, 2deg));
  }
  50% {
    transform: translate(0, calc(var(--float-y, 12rpx) * -1)) rotate(0deg);
  }
  75% {
    transform: translate(calc(var(--float-x, 8rpx) * -1), calc(var(--float-y, 12rpx) * -0.6))
      rotate(calc(var(--float-rotate, 2deg) * -1));
  }
  100% {
    transform: translate(0, 0) rotate(0deg);
  }
}

/* 脚印样式已移到 app.wxss（封面与地图页共用） */

/* 背景偏亮时保证文字可读（类名与 WXML 保持一致，阴影才真正生效） */
.cover__eyebrow1,
